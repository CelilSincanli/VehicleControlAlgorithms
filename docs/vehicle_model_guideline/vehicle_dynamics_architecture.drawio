        </mxCell>
        <mxCell id="p5_p2" parent="p5_lane1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" value="Popup — explicitly centered on the viewport&#xa;(SetNextWindowPos + GetMainViewport()-&gt;GetCenter())&#xa;list: &quot;Kinematic&quot;, &quot;Dynamic (Linear Tire)&quot;" vertex="1">
          <mxGeometry height="70" width="430" x="20" y="115" as="geometry" />
        </mxCell>
        <mxCell id="p5_p3" parent="p5_lane1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" value="On select: selectedVehicleModelKind_ = name;&#xa;modelDirty_ = true;&#xa;— NOT ResetSimulation(): swap applies live,&#xa;mid-run, without resetting the trace" vertex="1">
          <mxGeometry height="75" width="430" x="20" y="200" as="geometry" />
        </mxCell>
        <mxCell id="p5_p4" parent="p5_lane1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontStyle=2;align=left;spacingLeft=6;" value="Why safe both directions:&#xa;Kinematic always writes lateral_speed=0 and a&#xa;kinematic yaw_rate estimate every step, so handing&#xa;those to a freshly-swapped dynamic model is the&#xa;physically correct initial condition. Dynamic→&#xa;Kinematic: KinematicBicycleModel never reads&#xa;lateral_speed and only overwrites yaw_rate, so&#xa;stale dynamic state is simply inert next step." vertex="1">
          <mxGeometry height="140" width="430" x="20" y="290" as="geometry" />
        </mxCell>
        <mxCell id="p5_p5" parent="p5_lane1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;spacingLeft=6;" value="Layout fix: both this panel&#39;s subsystem sliders&#xa;AND the algorithm Parameter-Tuning panel below it&#xa;are each wrapped in their own bounded/scrollable&#xa;ImGui::BeginChild region — content scrolls instead&#xa;of bleeding into the sibling panel (bug found and&#xa;fixed during manual testing)." vertex="1">
          <mxGeometry height="110" width="430" x="20" y="445" as="geometry" />
        </mxCell>
        <mxCell id="p5_lane2" parent="1" style="swimlane;fontStyle=1;align=center;startSize=30;fillColor=#d5e8d4;strokeColor=#82b366;" value="Live Tuning Structs → Sliders" vertex="1">
