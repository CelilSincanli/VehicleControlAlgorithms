        <mxCell id="p5_t3" parent="p5_lane2" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=6;" value="TuneSteering { enabled, use_rate_limit,&#xa;               max_steering_wheel_rate }&#xa;→ &quot;Override Steering Defaults&quot; checkbox +&#xa;   &quot;Rate-Limited Steering&quot; checkbox +&#xa;   &quot;Max Steering Rate&quot; slider (20–500 deg/s)" vertex="1">
