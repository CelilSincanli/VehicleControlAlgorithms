          <mxGeometry height="90" width="460" x="30" y="170" as="geometry" />
        </mxCell>
        <mxCell id="p3_aero" parent="p3_laneSub" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=6;" value="IAeroModel  aero&#xa;→ SimpleAeroModel&#xa;Fx = −mass · CA · vx·|vx|&#xa;(bit-for-bit regression anchor vs. pre-refactor)" vertex="1">
          <mxGeometry height="90" width="460" x="510" y="170" as="geometry" />
        </mxCell>
        <mxCell id="p3_steer" parent="p3_laneSub" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=6;" value="ISteeringModel  steering&#xa;→ InstantaneousSteeringModel (default) or&#xa;   RateLimitedSteeringModel (steering.use_rate_limit)&#xa;Rate-limited: delta_max = max_rate · dt&#xa;— activates VehicleData::max_steering_wheel_rate,&#xa;  parsed since day one but unused until this work" vertex="1">
          <mxGeometry height="120" width="940" x="30" y="280" as="geometry" />
        </mxCell>
        <mxCell id="p3_iz" parent="p3_laneSub" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontStyle=2;align=left;spacingLeft=6;" value="Iz_ (yaw inertia, set once in the constructor):&#xa;VehicleData::yaw_inertia if &gt; 0 (JSON override), else&#xa;the mass·a·b two-point-mass estimate" vertex="1">
          <mxGeometry height="70" width="940" x="30" y="420" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
