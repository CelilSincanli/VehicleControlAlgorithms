          <mxGeometry height="70" width="260" x="20" y="40" as="geometry" />
        </mxCell>
        <mxCell id="p5_t2" parent="p5_lane2" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=6;" value="TuneSuspension { enabled, cog_height }&#xa;→ &quot;Override Suspension Defaults&quot; checkbox +&#xa;   &quot;CoG Height&quot; slider (0.2–2.5 m)" vertex="1">
